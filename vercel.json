{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "https://brigade.tools/cloche", "permanent": true },
    { "source": "/:path*", "destination": "https://brigade.tools/cloche", "permanent": true }
  ]
}

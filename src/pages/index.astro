---
/**
 * Product home: proof-first Cloche face.
 * Space cards and Studio lead; fleet affiliation stays light at the end.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyCommand from '../components/CopyCommand.astro';
import ClocheReveal from '../components/ClocheReveal.astro';
import FleetLinks from '../components/FleetLinks.astro';
import { SITE, EXTERNAL } from '../lib/site.ts';
import '../styles/product.css';

const SPACE_PALETTES = [
  { name: 'orion-emission', src: '/images/space/orion-emission.webp' },
  { name: 'carina-hubble', src: '/images/space/carina-hubble.webp' },
  { name: 'milkyway-core', src: '/images/space/milkyway-core.webp' },
  { name: 'horsehead-flame', src: '/images/space/horsehead-flame.webp' },
  { name: 'eagle-pillars', src: '/images/space/eagle-pillars.webp' },
  { name: 'crab-remnant', src: '/images/space/crab-remnant.webp' },
];

const COMMANDS = [
  { cmd: 'capture --target active', desc: 'Focused app or window. Default.' },
  { cmd: 'polish shot.png --palette milkyway-core --scene jwst', desc: 'Pin a deep-space look on an existing image.' },
  { cmd: 'studio', desc: 'Local visual picker for palettes, scenes, and motifs.' },
  { cmd: 'preview', desc: 'Open the most recent capture.' },
  { cmd: 'gallery --limit 10', desc: 'Self-contained HTML gallery of recent shots.' },
  { cmd: 'schema', desc: 'Stable JSON schema for capture output.' },
  { cmd: 'doctor --format json', desc: 'Validate capture support on this machine.' },
  { cmd: 'mcp', desc: 'Stdio MCP server over the same code path.' },
];
---
<BaseLayout>
  <div class="product">
    <header class="hero" id="proof">
      <div class="wrap">
        <p class="eyebrow">Escoffier Labs · Cloche</p>
        <h1>Lift the dome.<span class="accent">Present the shot.</span></h1>
        <p class="lede">
          Desktop capture for people and agents. Raw image, deep-space card, stable JSON.
        </p>
        <div class="cta-row">
          <CopyCommand command={SITE.install} />
          <a href="#space">See the skies</a>
        </div>
        <div class="meta">
          <span>MIT</span>
          <span>Linux + Windows</span>
          <span>CLI · Studio · MCP</span>
        </div>
      </div>
      <div class="wrap-wide">
        <div class="proof-pair">
          <figure class="proof-card">
            <img
              src="/images/space/card-milkyway-core.webp"
              alt="Polished Cloche shot card of a calculator window on a milkyway-core deep-space backdrop"
              width="990"
              height="1361"
              loading="eager"
              decoding="async"
            />
            <figcaption>calculator · milkyway-core · seed 3</figcaption>
          </figure>
          <figure class="proof-card">
            <img
              src="/images/space/card-carina-jwst.webp"
              alt="Polished Cloche shot card of a settings window on a carina-hubble backdrop with JWST scene look"
              width="1280"
              height="1437"
              loading="eager"
              decoding="async"
            />
            <figcaption>settings · carina-hubble · jwst · seed 42</figcaption>
          </figure>
        </div>
      </div>
    </header>

    <section class="band" id="space">
      <div class="wrap">
        <h2>Every card sits in a sky that never existed twice.</h2>
        <p class="lede">
          Deep-space palettes are sampled from real astrophotography, then drawn from noise at
          render time. Pin a palette or a telescope look; the same
          <code>--style-seed</code> reproduces one sky exactly.
        </p>
      </div>
      <div class="wrap-wide">
        <ul class="space-rail" aria-label="Deep-space palette samples">
          {SPACE_PALETTES.map((p) => (
            <li>
              <img src={p.src} alt="" width="480" height="270" loading="lazy" decoding="async" />
              <span>{p.name}</span>
            </li>
          ))}
        </ul>
        <p class="dim space-rail-note">
          Also: <code>pleiades-reflection</code>, <code>rho-ophiuchi</code>,
          <code>andromeda-haze</code>, <code>lagoon-trifid</code>, <code>tarantula-web</code>,
          <code>sombrero-dust</code>, and gradient or pattern backdrops when you want them.
          Scenes include <code>jwst</code>, <code>alma</code>, <code>cmb</code>, and more.
        </p>
        <div class="copy-block">
          <button type="button" class="copy-btn" data-copy>Copy</button>
          <pre>{`cloche polish shot.png --palette horsehead-flame --scene alma --style-seed 7`}</pre>
        </div>
      </div>
    </section>

    <section class="band" id="studio">
      <div class="wrap">
        <h2>Cloche Studio is the visual side of the same config.</h2>
        <p class="lede">
          Toggle which backdrops stay in rotation, preview scene looks and motifs, then write the
          preferences <code>capture</code> and <code>polish</code> already honor. Same flags in the
          terminal; Studio just lets you see them first.
        </p>
      </div>
      <div class="wrap-wide">
        <figure class="studio-shot">
          <img
            src="/images/space/studio-ui.webp"
            alt="Cloche Studio: live card preview, Randomize and Pin controls, and the matching cloche config set command"
            width="1280"
            height="900"
            loading="lazy"
            decoding="async"
          />
          <figcaption>cloche studio · local · writes ~/.config/cloche/config.json</figcaption>
        </figure>
        <figure class="studio-shot studio-shot-secondary">
          <img
            src="/images/space/studio-backdrops.webp"
            alt="Cloche Studio backdrops grid showing deep-space and gradient palettes"
            width="1280"
            height="900"
            loading="lazy"
            decoding="async"
          />
          <figcaption>deep space · gradients · patterns · scene looks · motifs</figcaption>
        </figure>
        <div class="copy-block">
          <button type="button" class="copy-btn" data-copy>Copy</button>
          <pre>{`cloche studio`}</pre>
        </div>
      </div>
    </section>

    <section class="band" id="shot">
      <div class="wrap">
        <h2>One capture. Three forms you can use.</h2>
        <p class="lede">
          Exit 0 only when the raw image is written. Card polish and text extraction are warnings if
          they fail, not silent zeros.
        </p>
        <dl class="anatomy">
          <dt>Raw</dt>
          <dd>
            <code>shot.png</code> exactly as the compositor saw it.
            <span class="cmd">cloche capture --target active</span>
          </dd>
          <dt>Card</dt>
          <dd>
            <code>shot-card.png</code> framed on a procedural sky for demos and posts.
            <span class="cmd">--palette · --scene · --style-seed</span>
          </dd>
          <dt>Contract</dt>
          <dd>
            The same JSON on disk and stdout. Pipe it, parse it, or hand it to an agent.
            <span class="cmd">cloche schema · metadata.json</span>
          </dd>
        </dl>
      </div>
    </section>

    <section class="band" id="modes">
      <div class="wrap">
        <h2>Shots ship. Motion is next.</h2>
        <p class="lede">One presentation system. Stills today; short recordings on the roadmap.</p>
        <ul class="mode-list">
          <li>
            <div>
              <span class="name">Shots</span>
              <span class="state">available</span>
            </div>
            <p class="job">Still capture of the active app or a named window, with card + metadata.</p>
          </li>
          <li>
            <div>
              <span class="name">Reels</span>
              <span class="state">planned</span>
            </div>
            <p class="job">Short desktop recordings with the same framing system. Not shipped as capture yet.</p>
          </li>
          <li>
            <div>
              <span class="name">GIF export</span>
              <span class="state">after Reels</span>
            </div>
            <p class="job">Loops from finished Reels as a delivery format, not a capture mode.</p>
          </li>
        </ul>
      </div>
    </section>

    <section class="band" id="agents">
      <div class="wrap">
        <h2>Same command for shell and agents</h2>
        <p class="lede">
          Agent-neutral by design. Codex, OpenClaw, Claude Code, Hermes, a local MCP client, or a
          plain script all share one path.
        </p>
        <div class="copy-block">
          <button type="button" class="copy-btn" data-copy>Copy</button>
          <pre>{`{ "type": "localImage", "path": "/abs/path/shot.png", "detail": "high" }`}</pre>
        </div>
        <p class="dim" style="margin-top:12px">
          <code>cloche codex-payload</code> builds a Codex turn/start payload from a shot directory.
          <code>cloche mcp</code> exposes the same code path over stdio.
        </p>
      </div>
    </section>

    <section class="band" id="commands">
      <div class="wrap">
        <h2>Commands you will actually use</h2>
        <table class="cmd-table">
          <thead>
            <tr><th>Command</th><th>What it does</th></tr>
          </thead>
          <tbody>
            {COMMANDS.map((c) => (
              <tr>
                <td>cloche {c.cmd}</td>
                <td>{c.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="dim" style="margin-top:16px">
          The <code>appshots</code> binary remains an alias for the same code path.
        </p>
      </div>
    </section>

    <section class="band" id="name">
      <div class="wrap">
        <h2>Why it's called Cloche</h2>
        <p class="lede">
          A cloche is the silver dome that presents a dish cleanly. Lift it, and the plate is ready.
        </p>
        <ClocheReveal />
      </div>
    </section>

    <section class="band" id="fleet">
      <div class="wrap">
        <h2>Part of the kitchen</h2>
        <p class="lede">
          Built by Escoffier Labs. Works alone; pairs with Brigade when you want receipts around the
          work that produced the shot.
        </p>
        <p class="fleet-note dim">
          <a href={EXTERNAL.github}>GitHub</a>
          ·
          <a href={EXTERNAL.releases}>Releases</a>
          ·
          <a href="/compare/screenshots-for-ai-agents">Screenshots for AI agents</a>
        </p>
      </div>
    </section>

    <FleetLinks current="cloche-site" />
  </div>

  <script>
    document.querySelectorAll('.product [data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const pre = (btn as HTMLElement).closest('.copy-block')?.querySelector('pre');
        if (!pre) return;
        const text = pre.innerText.replace(/\u00a0/g, ' ').replace(/\s+$/g, '') + '\n';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          /* ignore */
        }
        const el = btn as HTMLElement;
        el.textContent = 'Copied';
        setTimeout(() => {
          el.textContent = 'Copy';
        }, 1500);
      });
    });
  </script>
</BaseLayout>
